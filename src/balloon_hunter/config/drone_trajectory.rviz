Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Cell Size: 5
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1

    # ── Drone 1 (green / yellow) ──────────────────────────────────────────────
    - Class: rviz_default_plugins/Marker
      Name: D1 GT Trajectory (green)
      Enabled: true
      Value: true
      Topic:
        Value: /drone1/gt_trajectory
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/Marker
      Name: D1 PX4 Trajectory (yellow)
      Enabled: true
      Value: true
      Topic:
        Value: /drone1/px4_trajectory
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/Marker
      Name: D1 State Text
      Enabled: true
      Value: true
      Topic:
        Value: /drone1/state_text
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable

    # ── Drone 2 (cyan / orange) ───────────────────────────────────────────────
    - Class: rviz_default_plugins/Marker
      Name: D2 GT Trajectory (cyan)
      Enabled: true
      Value: true
      Topic:
        Value: /drone2/gt_trajectory
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/Marker
      Name: D2 PX4 Trajectory (orange)
      Enabled: true
      Value: true
      Topic:
        Value: /drone2/px4_trajectory
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/Marker
      Name: D2 State Text
      Enabled: true
      Value: true
      Topic:
        Value: /drone2/state_text
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable

    # ── Drone 3 (magenta / purple) ────────────────────────────────────────────
    - Class: rviz_default_plugins/Marker
      Name: D3 GT Trajectory (magenta)
      Enabled: true
      Value: true
      Topic:
        Value: /drone3/gt_trajectory
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/Marker
      Name: D3 PX4 Trajectory (purple)
      Enabled: true
      Value: true
      Topic:
        Value: /drone3/px4_trajectory
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/Marker
      Name: D3 State Text
      Enabled: true
      Value: true
      Topic:
        Value: /drone3/state_text
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable

    # ── Shared ────────────────────────────────────────────────────────────────
    - Class: rviz_default_plugins/Marker
      Name: Balloon Marker
      Enabled: true
      Value: true
      Topic:
        Value: /balloon/marker
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 30
      Focal Point:
        X: 0
        Y: 5
        Z: 3
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.5
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.785
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1200
